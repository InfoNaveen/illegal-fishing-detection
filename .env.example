# Copy this file to .env and fill in your own AISStream.io API key.
# NEVER commit the real .env file. It is already excluded via .gitignore.

AISSTREAM_API_KEY=your_aisstream_api_key_here

# Live AIS Monitoring Region (demonstration bounding box — NOT a legal
# restricted-fishing-zone claim). Defaults roughly match the Danish-waters
# demonstration region already used elsewhere in this project.
LIVE_AIS_MIN_LAT=53.5
LIVE_AIS_MIN_LON=3.0
LIVE_AIS_MAX_LAT=60.0
LIVE_AIS_MAX_LON=16.5

# Dashboard refresh interval (seconds) while Live AIS mode is active.
LIVE_AIS_REFRESH_SECONDS=3

# Seconds of silence before a vessel is considered stale and dropped from
# the live in-memory state.
LIVE_AIS_STALE_SECONDS=300

# Maximum trajectory points kept per vessel (bounded memory).
LIVE_AIS_MAX_TRAJECTORY_POINTS=50
